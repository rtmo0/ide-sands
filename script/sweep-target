#!/usr/bin/env python3
"""Delete artifacts in target/ that no current build uses.

Cargo never removes artifacts left behind by older sources, features or
toolchains, so target/ grows without bound. This asks cargo which artifacts
the current builds use (fresh units are reported too) and deletes every other
hashed artifact. cargo-sweep's --stamp mode is not used because it relies on
file access times, which APFS does not update reliably.

The kept builds are the ones the dev loop needs:
  - `cargo build -p sands -p cli` (the "Build Sands" task),
  - `cargo check --workspace --all-targets` (rust-analyzer's default check),
  - the remote server Sands cross-compiles for sandboxes into target/remote_server.

Incremental caches are deleted entirely because their directory hashes cannot
be matched to units; the next build of an edited crate is just not incremental.
Bundle builds (target/release, target/<triple>) are left alone.

Usage: script/sweep-target [--dry-run]
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
TARGET_DIR = REPO_ROOT / "target"
REMOTE_TARGET_DIR = TARGET_DIR / "remote_server"
HASHED_NAME = re.compile(r"^.+-([0-9a-f]{16})(?:\..*)?$")
HASHED_SUBDIRS = ["deps", "build", ".fingerprint", "examples"]


class BuildFailed(Exception):
    pass


def hash_of(name):
    match = HASHED_NAME.match(name)
    return match.group(1) if match else None


def used_hashes(command, env=None):
    print(f"==> {' '.join(command)}", file=sys.stderr, flush=True)
    process = subprocess.Popen(
        command + ["--message-format=json"],
        cwd=REPO_ROOT,
        env={**os.environ, **(env or {})},
        stdout=subprocess.PIPE,
        text=True,
    )
    hashes = set()
    for line in process.stdout:
        if not line.startswith("{"):
            continue
        message = json.loads(line)
        paths = []
        if message.get("reason") == "compiler-artifact":
            paths = message.get("filenames", [])
        elif message.get("reason") == "build-script-executed":
            paths = [message.get("out_dir", "")]
        for path in paths:
            for component in Path(path).parts:
                component_hash = hash_of(component)
                if component_hash:
                    hashes.add(component_hash)
    if process.wait() != 0:
        raise BuildFailed(f"`{' '.join(command)}` failed")
    return hashes


def disk_usage(path):
    if path.is_symlink() or not path.is_dir():
        return path.lstat().st_blocks * 512
    total = 0
    for root, dirs, files in os.walk(path):
        for name in dirs + files:
            total += (Path(root) / name).lstat().st_blocks * 512
    return total


def remove(path, dry_run):
    size = disk_usage(path)
    if not dry_run:
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
    return size


def sweep_profile_dir(profile_dir, keep, dry_run):
    freed = 0
    for subdir in HASHED_SUBDIRS:
        directory = profile_dir / subdir
        if not directory.is_dir():
            continue
        for entry in directory.iterdir():
            entry_hash = hash_of(entry.name)
            if entry_hash and entry_hash not in keep:
                freed += remove(entry, dry_run)
    incremental = profile_dir / "incremental"
    if incremental.is_dir():
        freed += remove(incremental, dry_run)
    return freed


def remote_server_builds():
    """Mirror how crates/remote/src/transport.rs builds the remote server."""
    if not REMOTE_TARGET_DIR.is_dir():
        return [], True
    builds = []
    all_supported = True
    for triple_dir in sorted(REMOTE_TARGET_DIR.iterdir()):
        triple = triple_dir.name
        if triple == "debug" or not (triple_dir / "debug").is_dir():
            continue
        if "-unknown-linux-" not in triple:
            print(f"skipping {triple_dir}: only Linux remote builds are mirrored", file=sys.stderr)
            all_supported = False
            continue
        rust_flags = os.environ.get("RUSTFLAGS", "")
        if triple.endswith("-musl"):
            rust_flags += " -C target-feature=+crt-static"
            zstd_musl_lib = os.environ.get("ZED_ZSTD_MUSL_LIB")
            if zstd_musl_lib:
                rust_flags += f" -C link-arg=-L{zstd_musl_lib}"
        command = [
            "cargo", "zigbuild",
            "--package", "remote_server",
            "--features", "debug-embed",
            "--target-dir", "target/remote_server",
            "--target", triple,
        ]
        builds.append((triple_dir / "debug", command, {"RUSTFLAGS": rust_flags}))
    return builds, all_supported


def main():
    dry_run = "--dry-run" in sys.argv[1:]
    try:
        local_keep = used_hashes(["cargo", "build", "-p", "sands", "-p", "cli"])
        local_keep |= used_hashes(["cargo", "check", "--workspace", "--all-targets"])

        remote_builds, all_remote_supported = remote_server_builds()
        remote_keep = set()
        remote_profile_dirs = []
        for profile_dir, command, env in remote_builds:
            remote_keep |= used_hashes(command, env)
            remote_profile_dirs.append(profile_dir)
    except BuildFailed as error:
        print(f"error: {error}; nothing was deleted", file=sys.stderr)
        return 1

    # Host-side build scripts and proc macros of remote builds live here, so
    # it is only safe to sweep when every remote build was accounted for.
    if remote_profile_dirs and all_remote_supported:
        remote_profile_dirs.append(REMOTE_TARGET_DIR / "debug")

    freed = sweep_profile_dir(TARGET_DIR / "debug", local_keep, dry_run)
    for profile_dir in remote_profile_dirs:
        freed += sweep_profile_dir(profile_dir, remote_keep, dry_run)

    verb = "Would free" if dry_run else "Freed"
    print(f"{verb} {freed / 2**30:.1f} GiB", file=sys.stderr)

    for bundle_dir in [TARGET_DIR / "release", TARGET_DIR / "aarch64-apple-darwin", TARGET_DIR / "x86_64-apple-darwin"]:
        if bundle_dir.is_dir():
            print(
                f"Not swept (bundle build): {bundle_dir} {disk_usage(bundle_dir) / 2**30:.1f} GiB",
                file=sys.stderr,
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
